<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BudgetMate"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="materialAlertDialogTheme">
            @style/CustomAlertDialogTheme
        </item>

    </style>

    <style name="Theme.BudgetMate"
        parent="Base.Theme.BudgetMate" />


    <!-- Positive button -->
    <style name="RedDialogButton"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">44dp</item>

        <!-- Space between negative and positive buttons -->
        <item name="android:layout_marginStart">12dp</item>
    </style>


    <!-- Negative button -->
    <style name="GrayDialogButton"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/gray</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>


    <!-- Actual dialog container -->
    <style name="Widget.BudgetMate.AlertDialog"
        parent="MaterialAlertDialog.Material3">

        <!-- Guarantees a white dialog container -->
        <item name="backgroundTint">@color/white</item>
    </style>


    <!-- Dialog theme overlay -->
    <style name="CustomAlertDialogTheme"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <!-- Use our custom white dialog container -->
        <item name="alertDialogStyle">
            @style/Widget.BudgetMate.AlertDialog
        </item>

        <!-- Keep dialog white, including dark mode -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>

        <!-- Prevent elevation from tinting the white surface -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Dialog text -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>

        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">
            @style/RedDialogButton
        </item>

        <item name="buttonBarNegativeButtonStyle">
            @style/GrayDialogButton
        </item>

    </style>

</resources>